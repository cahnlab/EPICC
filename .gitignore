# Snakemake
.snakemake/
logs/
benchmarks/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.venv/
venv/
.conda/

# R
.Rhistory
.Rdata
.RData
.Ruserdata
*.Rproj.user/

# IDE and editors
*.code-workspace
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Output directories (typically generated by workflow)
results/
results_*/
output/
genomes/
genomes_*/

# Test logs and data
tests/integration/*.log
test-data-prep/
# Consolidated scratch dir for local test/integration runs (results,
# genomes, and run logs). Point test invocations here via
# --output-dir/--genome-dir and redirect logs into it so a single
# ignore rule keeps the working tree clean.
test_runs/
# Stray run logs that predate the test_runs/ convention.
.test_logs/
*.test-*.log
subset-*.log
# Empty Read_files placeholders that conftest.py's stage_mock_inputs()
# autouse fixture regenerates before each integration run. The real
# binary fixtures in this dir (genome, GFF/GTF, ONT BAMs, bedMethyl)
# are already tracked; add any new real fixture with `git add -f`.
tests/integration/data/mock_inputs/

# Site-specific SLURM profile (CSHL Elzar); not shipped — profiles/slurm
# is the example. Other profiles/* are tracked.
profiles/elzar/

# Temporary files
*.tmp
*.temp
*.bak

# Local notes
NOTES.local.md

# Auto-generated config files
# no longer generated; kept to ignore files left behind by older runs
config/analysis_samplefile_*.tsv
config/config_test_local.yaml
dev/plans/
