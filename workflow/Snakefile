    # so it IS its own post-alignment identity. Point mapped_name at it rather than
    # the per-replicate 'Sample_ID__Genome' add_compat_columns computed, so callers
    # can use mapped_name uniformly for post-alignment paths on either kind of row
    # without appending the genome twice.
    analysis_samples["mapped_name"] = analysis_samples["sample_name"]

# ---------------------------------------------------------------------------
# Backward-compat helper functions (used by rule files during migration)
# ---------------------------------------------------------------------------

def split_mapped_name(token):
    """Split a post-alignment token into (Sample_ID, ref_genome).

    Accepts both forms so callers need not know which side of the alignment
    boundary they are on:
      'WT_H3K9me2_rep1'          -> ('WT_H3K9me2_rep1', None)   pre-alignment
      'WT_H3K9me2_rep1__ColCEN'  -> ('WT_H3K9me2_rep1', 'ColCEN')

    Split on the LAST '__'; Sample_ID and Genome are both validated to exclude
    the delimiter. A trailing component that names a configured genome is only
    *treated* as one by parse_sample_name if the (sample, genome) pair actually
    exists — analysis-level names also end in a genome
    ('ChIP_broad__WT__H3K9me2__ColCEN'), so the split alone cannot distinguish
    them and the caller must fall back on a miss.
    """
    base, sep, tail = str(token).rpartition("__")
    if sep:
        return base, tail
    return str(token), None


def base_sample(token):
    """Bare Sample_ID for a possibly genome-qualified token.

    Used by the alignment-boundary rules: their outputs are genome-qualified
    ('..._pe__WT_rep1__ColCEN.bam') but their FASTQ inputs are not
    ('trim__WT_rep1__R1.fastq.gz'), because read processing is shared across
    every reference the sample is mapped to. Sample_ID is validated to contain
    no '__', so the last delimiter always separates the genome.
    """
    return split_mapped_name(token)[0]


def _sample_row_dict(row, replicate=None):
    return {
        "data_type": row["data_type"],
        "line": row["line"],
        "tissue": row["tissue"],
        "sample_type": row["sample_type"],
        "replicate": row["replicate"] if replicate is None else replicate,
        "ref_genome": row["ref_genome"],
        "levels_label": row["levels_label"],
    }


def parse_sample_name(sample_name):
    """Look up a sample by name in the samples DataFrame.

    ``sample_name`` may be a bare Sample_ID (pre-alignment paths) or a
    genome-qualified '{Sample_ID}__{Genome}' token (post-alignment paths).
    Resolution order matters: the qualified interpretation is tried first but
    only accepted on an exact (Sample_ID, Genome) hit, so analysis-level names
    — which also end in '__{Genome}' — fall through to the analysis_samples
    lookup below instead of being mistaken for replicates.

    A bare Sample_ID that maps to several genomes raises rather than picking
    one: choosing arbitrarily is precisely the collision behind issue #39.
    """
    sid, genome = split_mapped_name(sample_name)
    if genome is not None:
        qualified = samples.loc[
            (samples["sample_name"] == sid) & (samples["ref_genome"] == genome)
        ]
        if not qualified.empty:
            return _sample_row_dict(qualified.iloc[0])

    match = samples.loc[samples["sample_name"] == sample_name]
    if not match.empty:
        genomes = match["ref_genome"].unique()
        if len(genomes) > 1:
            raise ValueError(
                f"Sample '{sample_name}' is mapped to multiple genomes "
                f"({', '.join(sorted(genomes))}), so this lookup is ambiguous. "
                f"Use the genome-qualified '{sample_name}__<Genome>' token; a "
                f"bare Sample_ID is only unambiguous before alignment."
            )
        return _sample_row_dict(match.iloc[0])

    # Fallback: analysis-level names (always report "merged" for replicate)
    match2 = analysis_samples.loc[analysis_samples["sample_name"] == sample_name]
    if not match2.empty:
        return _sample_row_dict(match2.iloc[0], replicate="merged")
    raise ValueError(f"Sample '{sample_name}' not found in samples or analysis_samples")

def get_sample_info_from_name(sname, df, field):
    """Look up a field value by bare or genome-qualified sample name.

    Post-alignment rules hold '{Sample_ID}__{Genome}' tokens, so match on
    mapped_name as well as sample_name (see match_sample_rows).
    """
    match = df.loc[df["sample_name"] == sname]
    if match.empty and "mapped_name" in df.columns:
        match = df.loc[df["mapped_name"] == sname]
    if match.empty:
        return None
    return match[field].iloc[0]

def get_sample_names_by_env(env, df):
    """Get all bare sample_names for a given env (pre-alignment paths)."""
    return df.loc[df['env'] == env, "sample_name"].tolist()

def get_mapped_names_by_env(env, df):
    """Get all genome-qualified names for a given env (post-alignment paths).

    The sibling of get_sample_names_by_env for everything from alignment
    onward. On analysis_samples the two agree, because an analysis name already
    carries its genome.
    """
    col = "mapped_name" if "mapped_name" in df.columns else "sample_name"
    return df.loc[df['env'] == env, col].tolist()

# Logic for intermediate target
def all_map_only_input(wildcards):
    map_files = []
    chkpt_files = []
    
    map_files += expand(f"{RESULTS_DIR}/combined/plots/mapping_stats_{{analysis_name}}_{{env}}.pdf", analysis_name = analysis_name, env=[env for env in UNIQUE_ENVS if env in ["RNA", "mC"]])
    if not config["aligned_bams"]:
        map_files += expand(f"{RESULTS_DIR}/combined/plots/mapping_stats_{{analysis_name}}_{{env}}.pdf", analysis_name = analysis_name, env=[env for env in UNIQUE_ENVS if env in ["ChIP", "ATAC"]])
    map_files += expand(f"{RESULTS_DIR}/combined/plots/srna_sizes_stats_{{analysis_name}}_{{env}}.pdf", analysis_name = analysis_name, env=[env for env in UNIQUE_ENVS if env in ["sRNA"]])
    
    for _, row in samples.iterrows():
        sname = row['sample_name']
        env = row['env']
        chkpt_files.append(f"{RESULTS_DIR}/{env}/chkpts/map_{env}__{sname}.done")
    
    return map_files + chkpt_files
        
