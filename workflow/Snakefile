# ---------------------------------------------------------------------------
# Workflow-level TMPDIR routing
# ---------------------------------------------------------------------------
# Default: every job gets its own subdirectory under {output_dir}/.tmp/, so
# tools that spill through TMPDIR (sort, samtools, STAR, fasterq-dump,
# deeptools, etc.) write to the project filesystem instead of the cluster's
# /tmp. This avoids ENOSPC on sites where /tmp is a tmpfs sized off the
# job's RAM allocation (e.g. SLURM JobContainerType=job_container/tmpfs).
# Per-job subdir is keyed on SLURM_JOB_ID *and* $$ (the rule shell's PID):
# SLURM_JOB_ID gives cross-node uniqueness under the SLURM executor, $$ gives
# per-shell uniqueness within a node. The $$ is essential -- without it, a
# local `--cores N` run launched inside a single sbatch allocation (no
# --profile) would hand every concurrent job the *same* .tmp/<SLURM_JOB_ID>
# dir, and the first job to finish would `rm -rf` it out from under its
# still-running siblings (deeptools workers writing _deeptools_*.bg via
# $TMPDIR then die with FileNotFoundError). With $$ appended, each shell owns
# a distinct dir, so concurrent jobs never collide; the EXIT trap cleans up on
# failure, or signals other than SIGKILL. Set use_node_tmpdir=true (or pass
# `epicc run --use-node-tmpdir`) to skip this and inherit whatever TMPDIR
# the cluster/site provides — useful when /tmp is fast local scratch with
# adequate capacity.
if not config.get("use_node_tmpdir", False):
    # TMPDIR must be ABSOLUTE. RESULTS_DIR is relative whenever output_dir is
    # (the default "results", and e.g. the integration tests' test_runs/...).
    # Some tools run sub-steps in a child process that chdir's into a staging
    # area before touching TMPDIR -- most notably `R CMD INSTALL`'s
    # byte-compile/lazy-load phase (the GO database build, create_GO_database).
    # A relative TMPDIR then resolves against the wrong CWD, the staged path
    # doesn't exist, and the install dies with "Error in file(con, "w") :
    # cannot open the connection". Anchoring to an absolute path fixes it;
    # jobs run from the snakemake workdir, which is this abspath's base.
    _tmpdir_base = os.path.abspath(RESULTS_DIR)
    # Quadruple braces escape twice: f-string → "{{...}}" → Snakemake .format()
    # → "{SLURM_JOB_ID:-local}" in the final bash command. The trailing ".$$"
    # has no braces, so it survives both passes untouched and bash expands it
    # to the rule shell's PID.
    shell.prefix(
        f'TMPDIR_JOB="{_tmpdir_base}/.tmp/${{{{SLURM_JOB_ID:-local}}}}.$$" && '
        'mkdir -p "$TMPDIR_JOB" && '
        'trap \'rm -rf "$TMPDIR_JOB"\' EXIT && '
        'export TMPDIR="$TMPDIR_JOB" && '
    )

