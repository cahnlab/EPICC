def derive_label_from_filename(path):
    """Strip extension(s) from a basename to use as a default plot label.

    "/data/target_genes.txt" → "target_genes"
    "/data/regions.bed.gz"   → "regions"
    """
    name = Path(path).name
    while True:
        stem, ext = os.path.splitext(name)
        if not ext:
            break
        name = stem
    return name or "target"


def validate_output_input(input_path, fmt):
    """Lightweight format check on the user-provided input file.

    "tsv_geneids" : at least one non-comment line, first column non-empty.
    "bed"         : at least one non-comment line with ≥3 cols where
                    col2/col3 are non-negative integers.
    "loci"        : just verify the file is non-empty and readable.

    Raises SystemExit with a clear message on validation failure.
    """
    p = Path(input_path)
    if not p.exists():
        sys.exit(f"Error: --input-file not found: {input_path}")
    if p.stat().st_size == 0:
        sys.exit(f"Error: --input-file is empty: {input_path}")

    # Open .gz transparently
    import gzip
    opener = gzip.open if str(p).endswith(".gz") else open
    try:
        with opener(p, "rt") as fh:
            first = None
            for line in fh:
                line = line.rstrip("\n")
                if not line or line.startswith("#"):
                    continue
                first = line
                break
    except OSError as e:
        sys.exit(f"Error: cannot read --input-file: {e}")

    if first is None:
        sys.exit(f"Error: --input-file has no data rows: {input_path}")

    if fmt == "tsv_geneids":
        cols = first.split("\t")
        if not cols[0].strip():
            sys.exit(
                f"Error: first column of {input_path} is empty (expected gene IDs)."
            )
    elif fmt == "bed":
        cols = first.split("\t")
        if len(cols) < 3:
            sys.exit(
                f"Error: {input_path} doesn't look like BED — expected ≥3 "
                f"tab-separated columns, got {len(cols)}."
            )
        try:
            start = int(cols[1])
            end = int(cols[2])
        except ValueError:
            # Could be a header row; let snakemake's has_header handle it
            return
        if start < 0 or end < start:
            sys.exit(
                f"Error: {input_path} BED coordinates look wrong on the "
                f"first data row (start={cols[1]}, end={cols[2]})."
            )
    elif fmt == "loci":
        # ShortStack accepts gff3, bed, or simple chr:start-end; just confirm readability
        return
    else:
        sys.exit(f"Internal error: unknown input format '{fmt}'")


def cmd_output(args, extra_args):
    """Run snakemake on a single user-targeted plot/output."""
    repo = find_repo_root()
    if not _is_installed_mode():
        os.chdir(repo)

    spec = OUTPUT_TYPES[args.plot_type]

    # --- Resolve label
    label = args.plot_label or derive_label_from_filename(args.input_file)
    # Strip any path components and disallow path separators
    if "/" in label or "\\" in label or label.startswith("-"):
        sys.exit(
            f"Error: --plot-label must be a plain identifier (no path "
            f"separators, no leading dash): got '{label}'"
        )

    # --- Validate input file format
    validate_output_input(args.input_file, spec["format"])

    # --- Optional GO background file (--plot-type go only)
    if getattr(args, "background", None):
        if args.plot_type != "go":
            sys.exit("Error: --background is only valid with --plot-type go.")
        validate_output_input(args.background, "tsv_geneids")

    # --- Load options to resolve analysis_name / output_dir defaults
    try:
        import yaml
    except ImportError:
        sys.exit("Error: PyYAML not available. Activate the epicc conda environment.")
    if not Path(args.options).exists():
        sys.exit(f"Error: Options file not found: {args.options}")
    with open(args.options) as f:
        cfg = yaml.safe_load(f) or {}

    analysis_name = args.analysis_name or cfg.get("analysis_name") or "epicc"
    output_dir = args.output_dir or cfg.get("output_dir", "results")
    ref_genome = args.ref_genome
    env = args.env
    matrix = args.matrix or "regions"

    # --- Required-arg gating per type
    for need in spec["needs"]:
        if not getattr(args, need.replace("-", "_"), None):
            sys.exit(
                f"Error: --{need.replace('_', '-')} is required for "
                f"--plot-type {args.plot_type}."
            )
    if "env" in spec["needs"] and env not in VALID_OUTPUT_ENVS:
        sys.exit(
            f"Error: --env {env!r} is not one of "
            f"{', '.join(VALID_OUTPUT_ENVS)}."
        )
    if matrix not in VALID_OUTPUT_MATRICES:
        sys.exit(
            f"Error: --matrix {matrix!r} is not one of "
            f"{', '.join(VALID_OUTPUT_MATRICES)}."
        )

    # --- Build target path
    target = spec["target"].format(
        output_dir=output_dir,
        analysis_name=analysis_name,
        ref_genome=ref_genome or "",
        env=env or "",
        label=label,
        matrix=matrix,
    )

    # --- Build snakemake config overrides for the target's input wiring
    sources = {
        "input_file": args.input_file,
        "label": label,
        "ref_genome": ref_genome or "",
    }
    config_overrides = []
    for cfg_key, source in spec["inputs"]:
        config_overrides.append(f"{cfg_key}={sources[source]}")
    if args.analysis_name:
        config_overrides.append(f"analysis_name={analysis_name}")
    if getattr(args, "background", None):
        config_overrides.append(f"rnaseq_background_file={args.background}")

    # --- Build snakemake command (re-uses the same execution-mode logic)
    cmd = ["snakemake"]
    if _is_installed_mode():
        cmd += ["--snakefile", str(repo / "workflow" / "Snakefile")]
    if not Path(args.options).exists():
        sys.exit(f"Error: Options file not found: {args.options}")
    cmd += ["--configfile", args.options]
    workflow_profile = getattr(args, "workflow_profile", None) or str(
        repo / DEFAULT_WORKFLOW_PROFILE
    )
    if Path(workflow_profile).is_dir():
        cmd += ["--workflow-profile", workflow_profile]
    profile, cores = detect_execution_mode(args)
    if profile:
        cmd += ["--profile", profile]
    else:
        cmd += ["--use-conda", "--conda-frontend", "conda", "--cores", str(cores)]
    if args.samples:
        if not Path(args.samples).exists():
            sys.exit(f"Error: Sample file not found: {args.samples}")
        config_overrides.append(f"sample_file={args.samples}")
    if args.output_dir:
        config_overrides.append(f"output_dir={args.output_dir}")
    if args.genome_dir:
        config_overrides.append(f"genome_dir={args.genome_dir}")
    if getattr(args, "use_node_tmpdir", False):
        config_overrides.append("use_node_tmpdir=true")
    if config_overrides:
        cmd += ["--config"] + config_overrides
    if not getattr(args, "no_rerun_incomplete", False):
        cmd.append("--rerun-incomplete")
    if args.verbose:
        cmd.append("--printshellcmds")
    if args.quiet:
        cmd.append("--quiet")
    if args.dry_run:
        cmd.append("--dry-run")
    if extra_args:
        cmd += extra_args
    # Use -- separator to prevent Snakemake from interpreting the target as an option
    cmd.append("--")
    cmd.append(target)

    print(f"EPICC: Targeting output → {target}", file=sys.stderr)
    if args.verbose:
        print(f"  Command: {' '.join(cmd)}", file=sys.stderr)

    result = subprocess.run(cmd)
    return result.returncode


def cmd_perf(args, extra_args):
    """Generate an execution timing report from a pipeline run's logs."""
    repo = find_repo_root()
    if not _is_installed_mode():
        os.chdir(repo)

    profiler = repo / "dev" / "profile_snakemake_log.py"
    if not profiler.exists():
        sys.exit(f"Error: Profiler script not found: {profiler}")

    cmd = [sys.executable, str(profiler)]

    if args.logfile:
        cmd.append(args.logfile)
    elif args.single:
        cmd.append("--single")

    if args.html:
        cmd += ["--html", args.html]

    if args.multi:
        cmd += ["--multi"] + args.multi

    result = subprocess.run(cmd)
    return result.returncode


def cmd_unlock(args, extra_args):
    """Unlock the working directory after a failed or interrupted run."""
    repo = find_repo_root()
    if not _is_installed_mode():
        os.chdir(repo)

    print("EPICC: Unlocking working directory...", file=sys.stderr)
    cmd = ["snakemake", "--unlock"]
    if _is_installed_mode():
        cmd += ["--snakefile", str(repo / "workflow" / "Snakefile")]
    result = subprocess.run(cmd)
    if result.returncode == 0:
        print("EPICC: Unlock complete.", file=sys.stderr)
    else:
        print(f"EPICC: Unlock failed (exit code {result.returncode}).",
              file=sys.stderr)
    return result.returncode


def cmd_clean(args, extra_args):
    """Selective cleanup of pipeline artifacts."""
    repo = find_repo_root()
    # Installed mode: pipeline artifacts (.snakemake/, results/, etc.) live
    # in the user's project CWD, not in the installed share directory.
    run_dir = Path.cwd() if _is_installed_mode() else repo
    if not _is_installed_mode():
        os.chdir(repo)

    if not any([args.intermediates, args.conda_envs, args.logs, args.tmp,
                args.all]):
        print("Nothing to clean. Specify --intermediates, --conda-envs, "
              "--logs, --tmp, or --all.", file=sys.stderr)
        return 1

    if args.logs or args.all:
        log_dir = run_dir / ".snakemake" / "log"
        if log_dir.exists():
            logs = list(log_dir.glob("*.snakemake.log"))
            if len(logs) > 1:
                # Keep the most recent, remove the rest
                logs.sort(key=lambda p: p.stat().st_mtime)
                old_logs = logs[:-1]
                print(f"Removing {len(old_logs)} old log file(s) "
                      f"(keeping most recent)...", file=sys.stderr)
                for log in old_logs:
                    log.unlink()
            else:
                print("No old logs to clean.", file=sys.stderr)

    if args.conda_envs or args.all:
        # The only path in `clean` that needs snakemake.
        check_snakemake_version()
        print("Cleaning unused conda environments...", file=sys.stderr)
        result = subprocess.run(
            ["snakemake", "--sdm", "conda", "--conda-cleanup-envs"],
            capture_output=True, text=True,
        )
        if result.returncode == 0:
            print("  Done.", file=sys.stderr)
        else:
            print(f"  Failed: {result.stderr.strip()}", file=sys.stderr)

    if args.intermediates or args.all:
        # Delete checkpoint files to force reanalysis
        output_dir = args.output_dir or "results"
        chkpt_dirs = list(run_dir.glob(f"{output_dir}/*/chkpts"))
        if chkpt_dirs:
            print(f"Removing checkpoint files from {len(chkpt_dirs)} "
                  f"environment(s)...", file=sys.stderr)
            for d in chkpt_dirs:
                for f in d.iterdir():
                    f.unlink()
            print("  Done. Re-run the pipeline to regenerate analysis.",
                  file=sys.stderr)
        else:
            print("No checkpoint files found.", file=sys.stderr)

    if args.tmp or args.all:
        # The shell.prefix traps EXIT to clean these up, but SIGKILL escapes
        # the trap -- so SLURM timeouts, OOM kills and node failures leak a
        # scratch dir each. Nothing else ever reclaims them.
        output_dir = args.output_dir or "results"
        tmp_root = run_dir / output_dir / ".tmp"
        if not tmp_root.is_dir():
            print("No scratch directory to reclaim.", file=sys.stderr)
        else:
            reclaimable, skipped = sweep_tmp_dirs(
                tmp_root, args.tmp_min_age, active_slurm_job_ids()
            )
            if not reclaimable:
                print(f"No reclaimable scratch dirs in {tmp_root}.",
                      file=sys.stderr)
            else:
                print(f"Reclaiming {len(reclaimable)} leaked scratch "
                      f"dir(s) from {tmp_root}...", file=sys.stderr)
                freed = 0
                for d in reclaimable:
                    try:
                        shutil.rmtree(d)
                        freed += 1
                    except OSError as exc:
                        # Metadata contention on a shared filesystem shows up
                        # here as EAGAIN; report it rather than dying, so the
                        # remaining dirs still get a chance.
                        print(f"  Could not remove {d.name}: {exc.strerror}",
                              file=sys.stderr)
                print(f"  Reclaimed {freed} of {len(reclaimable)}.",
                      file=sys.stderr)
            if skipped:
                print(f"  Left {len(skipped)} in place:", file=sys.stderr)
                for d, reason in skipped[:10]:
                    print(f"    {d.name} ({reason})", file=sys.stderr)
                if len(skipped) > 10:
                    print(f"    ... and {len(skipped) - 10} more",
                          file=sys.stderr)

    return 0


def cmd_init_profile(args, extra_args):
    """Install a cluster execution profile template to the Snakemake config dir."""
    repo = find_repo_root()
    template_dir = repo / "profiles" / args.profile_type
    if not (template_dir / "config.yaml").exists():
        available = sorted(
            p.name for p in (repo / "profiles").iterdir()
            if p.is_dir() and (p / "config.yaml").exists() and p.name != "default"
        )
        sys.exit(
            f"Error: No profile template for '{args.profile_type}'. "
            f"Available: {', '.join(available)}."
        )

    profile_name = args.name or args.profile_type
    xdg = os.environ.get("XDG_CONFIG_HOME")
    smk_config = (Path(xdg) / "snakemake") if xdg else (Path.home() / ".config" / "snakemake")
    dest = smk_config / profile_name

    if dest.exists() and not args.force:
        sys.exit(
            f"Error: Profile '{profile_name}' already exists at {dest}.\n"
            f"  Use --force to overwrite, or choose a different name."
        )

    dest.mkdir(parents=True, exist_ok=True)
    for src in template_dir.iterdir():
        import shutil as _shutil
        _shutil.copy2(src, dest / src.name)

    print(f"EPICC: Profile '{args.profile_type}' installed to {dest}/config.yaml",
          file=sys.stderr)
    print(f"  Edit the EDIT: markers in that file for your cluster (account,",
          file=sys.stderr)
    print(f"  partition, per-rule resource overrides).", file=sys.stderr)
    print(f"  Then run:  epicc run --samples <file.tsv> --profile {profile_name}",
          file=sys.stderr)
    return 0


