#!/usr/bin/env python3
"""EPICC — Epigenetic Pipeline for Integrative Chromatin Characterization.

User-friendly CLI wrapper around the EPICC Snakemake pipeline.

Usage:
    epicc run [options] [-- SNAKEMAKE_ARGS...]
    epicc validate [options]
    epicc output --plot-type TYPE --input-file PATH [options]
    epicc perf [--single | LOGFILE] [--html FILE]
    epicc clean [--intermediates] [--conda-envs] [--logs] [--all]
    epicc init-profile TYPE [NAME] [--force]

For a dry-run, prefer ``epicc validate`` (parses the config + sample sheet
and surfaces a concise summary) or pass --dry-run through to snakemake
via ``epicc run -- --dry-run`` for the raw output.
"""

import argparse
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

DESCRIPTION = """\
EPICC — Epigenetic Pipeline for Integrative Chromatin Characterization.

Snakemake pipeline for ChIP-seq, ATAC-seq, RNA-seq, small RNA-seq, bisulfite
methylC-seq, and direct methylation from long-read sequencing.
"""

DEFAULT_OPTIONS = "config/epicc-options.yaml"
DEFAULT_PROFILE = "profiles/slurm"
DEFAULT_WORKFLOW_PROFILE = "profiles/default"

# Snakemake 8 introduced the executor-plugin interface (`--executor`); the
# workflow additionally calls min_version("9.0").
MIN_SNAKEMAKE = (9, 0, 0)

# Subcommands that always shell out to snakemake, and so are worth
# version-checking up front. Deliberately excluded: `init-profile` (copies a
# template), `perf` (runs dev/profile_snakemake_log.py under sys.executable),
# and `clean` (filesystem work; it checks separately in its --conda-envs
# branch, the only path that needs snakemake). Those must keep working on a
# machine with no epicc environment at all.
SNAKEMAKE_COMMANDS = frozenset({"run", "validate", "output", "unlock"})


