def add_common_options(parser):
    """Add options shared by run/validate."""
    parser.add_argument(
        "--options", default=DEFAULT_OPTIONS, metavar="FILE",
        help=f"Path to options YAML file (default: {DEFAULT_OPTIONS})",
    )
    parser.add_argument(
        "--samples", metavar="FILE",
        help="Path to sample sheet TSV (overrides options file value)",
    )
    parser.add_argument(
        "--cores", type=int, metavar="N",
        help="Cores for local execution (default: auto, half of nproc)",
    )
    parser.add_argument(
        "--profile", metavar="DIR",
        help=f"Cluster (execution) profile directory with executor and "
             f"site-specific settings (default: auto-detect; uses "
             f"{DEFAULT_PROFILE} if sbatch is available)",
    )
    parser.add_argument(
        "--workflow-profile", metavar="DIR",
        help=f"Workflow profile directory with per-rule resources/threads "
             f"(default: {DEFAULT_WORKFLOW_PROFILE})",
    )
    parser.add_argument(
        "--output-dir", metavar="DIR",
        help="Output directory prefix (default: results)",
    )
    parser.add_argument(
        "--genome-dir", metavar="DIR",
        help="Genome directory prefix (default: genomes)",
    )
    parser.add_argument(
        "--keep-intermediates", metavar="TIER",
        choices=["none", "standard", "custom", "all"],
        help="Intermediate file retention tier (none/standard/custom/all)",
    )
    parser.add_argument(
        "--use-node-tmpdir", action="store_true",
        help="Skip the workflow-level TMPDIR override so jobs inherit TMPDIR "
             "from the environment. This does NOT force /tmp: an exported "
             "TMPDIR reaches jobs (sbatch --export=ALL), as does one set by a "
             "site prolog or the profile's precommand; /tmp is only the "
             "fallback when nothing sets it. By default, every job gets its "
             "own subdir under <output_dir>/.tmp/ to avoid ENOSPC on sites "
             "with a small in-memory /tmp tmpfs.",
    )
    verbosity = parser.add_mutually_exclusive_group()
    verbosity.add_argument(
        "--verbose", "-v", action="store_true",
        help="Verbose output (print shell commands)",
    )
    verbosity.add_argument(
        "--quiet", "-q", action="store_true",
        help="Minimal output",
    )


def add_run_options(parser):
    """Add options specific to run."""
    parser.add_argument(
        "--target", metavar="TARGET",
        help="Named target (default: all)",
    )
    parser.add_argument(
        "--until", metavar="RULE",
        help="Stop after this rule completes",
    )
    parser.add_argument(
        "--forcerun", nargs="+", metavar="RULE",
        help="Force re-execution of specific rules",
    )
    parser.add_argument(
        "--auto-unlock", action="store_true",
        help="If a stale Snakemake lock is detected at startup, clear it and "
             "continue (default: halt and report the lock, like snakemake). "
             "Only use when you are sure no other run is active on this "
             "directory; run 'epicc unlock' to clear a lock manually",
    )
    parser.add_argument(
        "--no-rerun-incomplete", action="store_true",
        help="Don't pass --rerun-incomplete to snakemake. Default behavior "
             "is to re-run any jobs Snakemake marked incomplete on a prior "
             "interrupted run; opt out when you want to inspect which jobs "
             "are flagged incomplete or force a fresh start without "
             "re-running them.",
    )


def add_graph_options(parser):
    """Add --dag / --rulegraph file outputs.

    Format is inferred from the file extension (.png/.svg/.pdf via graphviz
    ``dot``; .dot writes raw dot text). Available on validate.
    """
    parser.add_argument(
        "--dag", metavar="FILE",
        help="Render the per-job DAG to FILE (format from extension: "
             "png/svg/pdf/dot). Requires graphviz 'dot' for non-dot formats.",
    )
    parser.add_argument(
        "--rulegraph", metavar="FILE",
        help="Render the rule-level graph to FILE (format from extension).",
    )


def add_analysis_options(parser):
    """Add analysis configuration overrides for run/validate.

    All flags override the corresponding setting in the options YAML file.
    Omitting a flag leaves the options file value unchanged.
    Top-level settings go through --config directly; nested settings
    (dmr_thresholds.*, chip_callpeaks.params, cut_callpeaks.*) are applied
    via a temporary merged config file written by _prepare_options_file.
    """
    # --- Aligners and mapping ---
    parser.add_argument(
        "--chip-aligner", dest="chip_aligner", choices=["bowtie2", "chromap"],
        metavar="{bowtie2,chromap}",
        help="ChIP/CUT&RUN/CUT&Tag aligner (overrides chip_aligner). "
             "bowtie2 (default) is recommended for PE data; chromap is ~10x "
             "faster but yields low proper-pair rates on PE libraries.",
    )
    parser.add_argument(
        "--atac-aligner", dest="atac_aligner", choices=["bowtie2", "chromap"],
        metavar="{bowtie2,chromap}",
        help="ATAC-seq aligner (overrides atac_aligner). "
             "Same speed/quality trade-offs as --chip-aligner.",
    )
    parser.add_argument(
        "--chip-mapping-strategy", dest="chip_mapping_strategy",
        choices=["default", "repeat", "repeatall", "all"], metavar="STRATEGY",
        help="ChIP/CUT&RUN/CUT&Tag mapping strategy (overrides chip_mapping_strategy): "
             "default, repeat, repeatall, or all.",
    )
    parser.add_argument(
        "--atac-mapping-strategy", dest="atac_mapping_strategy",
        choices=["default", "repeat", "repeatall", "all"], metavar="STRATEGY",
        help="ATAC-seq mapping strategy (overrides atac_mapping_strategy).",
    )

    # --- Analysis toggles ---
    _fa = parser.add_mutually_exclusive_group()
    _fa.add_argument(
        "--full-analysis", dest="full_analysis", action="store_true",
        help="Enable full downstream analysis (overrides full_analysis in options).",
    )
    _fa.add_argument(
        "--no-full-analysis", dest="full_analysis", action="store_false",
        help="Skip downstream analysis; mapping and peak-calling only.",
    )
    parser.set_defaults(full_analysis=None)

    _te = parser.add_mutually_exclusive_group()
    _te.add_argument(
        "--te-analysis", dest="te_analysis", action="store_true",
        help="Enable TE-annotation analysis (overrides te_analysis in options).",
    )
    _te.add_argument(
        "--no-te-analysis", dest="te_analysis", action="store_false",
        help="Disable TE-annotation analysis.",
    )
    parser.set_defaults(te_analysis=None)

    _go = parser.add_mutually_exclusive_group()
    _go.add_argument(
        "--go", dest="GO", action="store_true",
        help="Enable GO enrichment analysis (overrides GO in options).",
    )
    _go.add_argument(
        "--no-go", dest="GO", action="store_false",
        help="Disable GO enrichment analysis.",
    )
    parser.set_defaults(GO=None)

    _dedup = parser.add_mutually_exclusive_group()
    _dedup.add_argument(
        "--rna-deduplicate", dest="rna_deduplicate", action="store_true",
        help="Mark/remove duplicate reads for mRNA-seq (overrides rna_deduplicate "
             "in options). Only meaningful with UMIs, which are not yet handled. "
             "RAMPAGE is deduplicated regardless.",
    )
    _dedup.add_argument(
        "--no-rna-deduplicate", dest="rna_deduplicate", action="store_false",
        help="Disable mRNA-seq read deduplication (the default).",
    )
    parser.set_defaults(rna_deduplicate=None)

    # --- Methylation contexts ---
    parser.add_argument(
        "--methylation-contexts", dest="methylation_contexts",
        type=lambda s: [c.strip().upper() for c in s.split(",")],
        metavar="CONTEXTS",
        help="Comma-separated methylation contexts to analyze "
             "(overrides methylation_contexts). E.g. 'CG' for animal genomes "
             "where non-CpG methylation is negligible (default: CG,CHG,CHH).",
    )

    # --- DMR settings ---
    parser.add_argument(
        "--dmr-caller", dest="dmr_caller", choices=["metilene", "dmrcaller"],
        metavar="{metilene,dmrcaller}",
        help="DMR caller for Bismark-aligned samples (overrides dmr_caller). "
             "metilene (default) is multi-threaded and faster; "
             "dmrcaller uses beta-regression statistics.",
    )
    parser.add_argument(
        "--dmr-min-diff", dest="dmr_min_diff", type=_parse_dmr_min_diff,
        metavar="SPEC",
        help="Minimum mean methylation difference to call a DMR "
             "(overrides dmr_thresholds.min_diff). "
             "SPEC: 'auto' (data-driven per-pair calibration), "
             "a single float applied to all contexts (e.g. 0.2), "
             "or per-context values 'CG=0.3,CHG=0.2,CHH=0.1'.",
    )
    parser.add_argument(
        "--dmr-min-cytosines", dest="dmr_min_cytosines", type=int, metavar="N",
        help="Minimum cytosine/CpG count per DMR window "
             "(overrides dmr_thresholds.min_cytosines; default: 5).",
    )
    parser.add_argument(
        "--dmr-q-value", dest="dmr_q_value", type=float, metavar="Q",
        help="FDR q-value (adjusted p-value) threshold for DMR significance "
             "(overrides dmr_thresholds.q_value; default: 0.01). Applies to "
             "both callers: DMRcaller filters internally on its BH-adjusted "
             "pValue, metilene filters on its q-value column.",
    )
    parser.add_argument(
        "--dmr-sigma-n", dest="dmr_sigma_n", type=float, metavar="N",
        help="Noise-floor sigma multiplier for data-driven min_diff calibration "
             "(overrides dmr_thresholds.sigma_n; default: 3.0; "
             "only used when --dmr-min-diff auto).",
    )

    # --- Peak calling ---
    parser.add_argument(
        "--chip-callpeaks-params", dest="chip_callpeaks_params", metavar="STR",
        help="MACS2 parameters for ChIP peak calling "
             "(overrides chip_callpeaks.params; "
             "default: '--keep-dup all --nomodel').",
    )
    parser.add_argument(
        "--cut-broad-caller", dest="cut_broad_caller",
        choices=["epic2", "seacr", "macs2"], metavar="{epic2,seacr,macs2}",
        help="Peak caller for CUT&RUN/CUT&Tag broad marks "
             "(overrides cut_callpeaks.broad_caller; default: epic2).",
    )
    parser.add_argument(
        "--cut-narrow-caller", dest="cut_narrow_caller",
        choices=["seacr", "macs2"], metavar="{seacr,macs2}",
        help="Peak caller for CUT&RUN/CUT&Tag narrow marks/TFs "
             "(overrides cut_callpeaks.narrow_caller; default: seacr).",
    )


def build_parser():
    """Build the argument parser with subcommands."""
    parser = argparse.ArgumentParser(
        prog="epicc",
        description=DESCRIPTION,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # --- run ---
    p_run = subparsers.add_parser(
        "run", help="Execute the pipeline",
        description="Run the EPICC pipeline. Arguments after -- are passed "
                    "directly to snakemake.",
    )
    add_common_options(p_run)
    add_run_options(p_run)
    add_analysis_options(p_run)

    # --- validate ---
    p_val = subparsers.add_parser(
        "validate", help="Validate configuration",
        description="Check the options file and sample sheet for errors, "
                    "then run a snakemake dry-run for full DAG validation.",
    )
    add_common_options(p_val)
    add_graph_options(p_val)
    add_analysis_options(p_val)
    p_val.add_argument(
        "--build-envs", action="store_true",
        help="After validation passes, pre-build all rule conda envs "
             "(snakemake --conda-create-envs-only). Useful before sbatch-"
             "wrapped runs on clusters where conda env creation fails "
             "from inside a SLURM job (issue #25). Run from a login node.",
    )

    # --- output ---
    p_out = subparsers.add_parser(
        "output", help="Generate a single targeted output (plot/GO/clusters/browser)",
        description="Run a single, user-targeted output type against a "
                    "supplied input file. Available types: "
                    + ", ".join(OUTPUT_TYPES.keys()) + ".",
    )
    add_common_options(p_out)
    p_out.add_argument(
        "--plot-type", required=True, choices=sorted(OUTPUT_TYPES.keys()),
        help="Output product to generate.",
    )
    p_out.add_argument(
        "--input-file", required=True, metavar="PATH",
        help="Input data file for the target output (gene list, BED, "
             "GFF/loci file). Format is validated per --plot-type.",
    )
    p_out.add_argument(
        "--plot-label", metavar="LABEL",
        help="Label embedded in output filenames. Defaults to the input "
             "file's basename without extension.",
    )
    p_out.add_argument(
        "--background", metavar="PATH",
        help="Optional gene-ID background file for GO enrichment "
             "(--plot-type go only): tab-delimited with gene IDs in the first "
             "column. Sets rnaseq_background_file for this run. Default "
             "background is all genes in the genome.",
    )
    p_out.add_argument(
        "--analysis-name", metavar="NAME",
        help="Override analysis_name from the options file.",
    )
    p_out.add_argument(
        "--ref-genome", metavar="GENOME",
        help="Reference genome name (must match a genome configured in "
             "the options file). Required for most plot types.",
    )
    p_out.add_argument(
        "--env", metavar="ENV", choices=VALID_OUTPUT_ENVS,
        help="Data type for env-aware plots (heatmap/metaplot/browser): "
             + ", ".join(VALID_OUTPUT_ENVS) + ".",
    )
    p_out.add_argument(
        "--matrix", metavar="KIND", choices=VALID_OUTPUT_MATRICES,
        default="regions",
        help="Matrix layout for heatmap/metaplot: regions (whole feature), "
             "tss, or tes. Default: regions.",
    )
    p_out.add_argument(
        "--dry-run", action="store_true",
        help="Resolve and print the snakemake plan without running.",
    )

    # --- perf ---
    p_perf = subparsers.add_parser(
        "perf", help="Profile pipeline performance",
        description="Generate an execution timing report from snakemake log "
                    "files. By default, all logs from the most recent resumed "
                    "run are aggregated. Wraps dev/profile_snakemake_log.py.",
    )
    p_perf.add_argument(
        "logfile", nargs="?",
        help="Path to a specific .snakemake.log file, or a run's results "
             "directory (output_dir) to aggregate that run's logs "
             "(default: aggregate latest run)",
    )
    p_perf.add_argument(
        "--single", action="store_true",
        help="Profile only the newest single log, without aggregating",
    )
    p_perf.add_argument(
        "--html", metavar="FILE",
        help="Write HTML report to FILE",
    )
    p_perf.add_argument(
        "--multi", nargs="+", metavar="LABEL=LOG",
        help="Generate multi-section HTML: 'Label=path/to/log' ...",
    )

    # --- unlock ---
    subparsers.add_parser(
        "unlock", help="Unlock the working directory",
        description="Remove Snakemake's directory lock after a failed or "
                    "interrupted run. Equivalent to 'snakemake --unlock'.",
    )

    # --- init-profile ---
    p_init = subparsers.add_parser(
        "init-profile",
        help="Install a cluster execution profile to ~/.config/snakemake/",
        description=(
            "Copy a bundled cluster profile template to the Snakemake user "
            "configuration directory (~/.config/snakemake/NAME/config.yaml). "
            "After installation, edit the EDIT: markers in that file, then use "
            "'epicc run --profile NAME'. Useful when EPICC is installed via "
            "conda and the bundled profiles/ directory is not in the project tree."
        ),
    )
    p_init.add_argument(
        "profile_type", choices=["slurm", "uge"],
        metavar="TYPE",
        help="Cluster scheduler type: 'slurm' (Slurm Workload Manager) or "
             "'uge' (Univa/Open Grid Engine, qsub-based).",
    )
    p_init.add_argument(
        "name", nargs="?",
        metavar="NAME",
        help="Profile name (used with --profile NAME). Defaults to TYPE.",
    )
    p_init.add_argument(
        "--force", action="store_true",
        help="Overwrite an existing profile with the same name.",
    )

    # --- clean ---
    p_clean = subparsers.add_parser(
        "clean", help="Clean pipeline artifacts",
        description="Selectively remove pipeline artifacts like old logs, "
                    "unused conda environments, and checkpoint files.",
    )
    p_clean.add_argument(
        "--output-dir", metavar="DIR",
        help="Output directory to clean (default: results)",
    )
    p_clean.add_argument(
        "--intermediates", action="store_true",
        help="Remove checkpoint files (forces reanalysis on next run)",
    )
    p_clean.add_argument(
        "--conda-envs", action="store_true",
        help="Remove unused conda environments",
    )
    p_clean.add_argument(
        "--logs", action="store_true",
        help="Remove old snakemake log files (keeps most recent)",
    )
    p_clean.add_argument(
        "--tmp", action="store_true",
        help="Reclaim leaked per-job scratch dirs under <output_dir>/.tmp/ "
             "(left behind by jobs killed with SIGKILL, e.g. SLURM timeouts)",
    )
    p_clean.add_argument(
        "--tmp-min-age", metavar="HOURS", type=float, default=6.0,
        help="With --tmp, only reclaim scratch dirs untouched for this many "
             "hours (default: 6). Guards against deleting scratch out from "
             "under a running job.",
    )
    p_clean.add_argument(
        "--all", action="store_true",
        help="All of the above",
    )

    return parser


def main():
    parser = build_parser()

    # Split args at -- to separate epicc args from snakemake passthrough
    argv = sys.argv[1:]
    if "--" in argv:
        split_idx = argv.index("--")
        epicc_args = argv[:split_idx]
        extra_args = argv[split_idx + 1:]
    else:
        epicc_args = argv
        extra_args = []

    args = parser.parse_args(epicc_args)

    dispatch = {
        "run": cmd_run,
        "validate": cmd_validate,
        "output": cmd_output,
        "unlock": cmd_unlock,
        "perf": cmd_perf,
        "clean": cmd_clean,
        "init-profile": cmd_init_profile,
    }

    handler = dispatch.get(args.command)
    if handler is None:
        parser.print_help()
        return 1

    if args.command in SNAKEMAKE_COMMANDS:
        check_snakemake_version()

    return handler(args, extra_args)


if __name__ == "__main__":
    sys.exit(main())
