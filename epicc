def _scan_log_for_env_failure(repo):
    """Return True if the most recent .snakemake/log entry shows a conda env
    creation failure. Used to surface a targeted recovery hint after cmd_run.
    """
    run_dir = Path.cwd() if _is_installed_mode() else repo
    log_dir = run_dir / ".snakemake" / "log"
    try:
        latest = max(log_dir.glob("*.snakemake.log"), key=lambda p: p.stat().st_mtime)
    except (FileNotFoundError, ValueError):
        return False
    try:
        text = latest.read_text(errors="replace")
    except OSError:
        return False
    return "CreateCondaEnvironmentException" in text


def cmd_run(args, extra_args):
    """Execute the pipeline."""
    repo = find_repo_root()
    if not _is_installed_mode():
        os.chdir(repo)

    maybe_clear_stale_lock(args, extra_args, repo)

    profile, cores = detect_execution_mode(args)
    check_profile_placeholders(profile)
    mode_desc = f"profile {profile}" if profile else f"{cores} local cores"
    cmd = build_snakemake_cmd(args, extra_args)
    print(f"EPICC: Starting pipeline ({mode_desc})", file=sys.stderr)
    if args.verbose:
        print(f"  Command: {' '.join(cmd)}", file=sys.stderr)

    t0 = time.time()
    result = subprocess.run(cmd)
    elapsed = time.time() - t0

    print(file=sys.stderr)
    if result.returncode == 0:
        print(f"EPICC: Pipeline completed in {fmt_duration(elapsed)}.",
              file=sys.stderr)
        print("  Tip: Run 'epicc perf' to see the execution timing report.",
              file=sys.stderr)
    else:
        print(f"EPICC: Pipeline failed after {fmt_duration(elapsed)} "
              f"(exit code {result.returncode}).", file=sys.stderr)
        # A leftover lock means a prior run was killed, or this run was
        # refused because the directory is already locked. Point users at the
        # epicc subcommand rather than snakemake's raw `--unlock` suggestion.
        if _lock_present(repo):
            print(
                "\n  The working directory is locked. If no other epicc run is "
                "active here, a\n  prior run was likely killed — clear the lock "
                "with:\n      epicc unlock\n  or re-run with 'epicc run "
                "--auto-unlock' to clear it automatically.",
                file=sys.stderr,
            )
        # Some clusters reject `conda env create --prefix` from inside a
        # SLURM job allocation, while the same install works from a login
        # node (issue #25). Detect the symptom in the snakemake log and
        # point users at the prebuild path.
        if _scan_log_for_env_failure(repo):
            print(
                "\n  Looks like a conda environment failed to install. "
                "If this run was launched via sbatch, try pre-building the\n"
                "  envs from a login/dev node first:\n"
                "      epicc validate --build-envs --options ... --samples ...\n"
                "  then resubmit the run.",
                file=sys.stderr,
            )

    return result.returncode


def _run_build_envs(args, extra_args):
    """Pre-build all rule conda envs via `snakemake --conda-create-envs-only`.

    Returns the snakemake exit code. Streams snakemake's own progress
    directly so users see per-env install logs (which can be slow).
    """
    if os.environ.get("SLURM_JOB_ID"):
        print(
            "  [!] Detected SLURM_JOB_ID — pre-building envs from inside a\n"
            "      SLURM job is the failure mode this is meant to work\n"
            "      around (issue #25). Run from a login/dev node instead.\n",
            file=sys.stderr,
        )
    print("\n  Building conda envs (this may take several minutes)...\n",
          file=sys.stderr)
    cmd = build_snakemake_cmd(args, extra_args)
    cmd.append("--conda-create-envs-only")
    if args.verbose:
        print(f"  Command: {' '.join(cmd)}", file=sys.stderr)
    return subprocess.run(cmd).returncode


def cmd_validate(args, extra_args):
    """Validate configuration without running the pipeline."""
    repo = find_repo_root()
    if not _is_installed_mode():
        os.chdir(repo)

    options_file = Path(args.options)
    if not options_file.exists():
        sys.exit(f"Error: Options file not found: {options_file}")

    # Catch unedited placeholder values in the cluster profile (e.g.
    # slurm_account=<your-slurm-account>) before snakemake even starts.
    check_profile_placeholders(getattr(args, "profile", None))

    print("EPICC: Validating configuration...\n", file=sys.stderr)

    # Load and display config summary
    try:
        import yaml
    except ImportError:
        sys.exit("Error: PyYAML not available. Activate the epicc conda environment.")

    with open(options_file) as f:
        config = yaml.safe_load(f)

    # Basic config checks
    sample_file = args.samples or config.get("sample_file")
    if not sample_file:
        sys.exit(
            "Error: no sample sheet specified. Pass --samples PATH on the "
            "CLI, or set `sample_file:` in your options YAML."
        )
    print(f"  Options file:  {options_file}", file=sys.stderr)
    print(f"  Sample file:   {sample_file}", file=sys.stderr)
    print(f"  Repo folder:   {config.get('repo_folder', '(auto-detected)')}",
          file=sys.stderr)
    print(f"  Analysis name: {config.get('analysis_name', '(not set)')}",
          file=sys.stderr)
    print(f"  Full analysis: {config.get('full_analysis', '(not set)')}",
          file=sys.stderr)

    # Genomes
    genomes = config.get("genomes", {})
    if genomes:
        print(f"  Genomes:       {', '.join(genomes.keys())}",
              file=sys.stderr)
    else:
        print("  Genomes:       (none configured)", file=sys.stderr)

    # Check files exist
    errors = []
    if not Path(sample_file).exists():
        errors.append(f"Sample file not found: {sample_file}")
    repo_folder = config.get("repo_folder")
    if repo_folder and not Path(repo_folder).is_dir():
        errors.append(f"Repo folder not found: {repo_folder}")
    genome_fields = [
        ("fasta_file", "FASTA"),
        ("gff_file", "GFF"),
        ("te_file", "TE"),
    ]
    url_checks = []
    for gname, gconf in genomes.items():
        for field, label in genome_fields:
            value = gconf.get(field, "")
            if not value:
                continue
            if is_url(value):
                url_checks.append((gname, label, value))
            elif not Path(value).exists():
                errors.append(f"Genome {gname}: {label} not found: {value}")
    if url_checks:
        print(f"\n  Checking {len(url_checks)} genome URL(s)...",
              file=sys.stderr)
        for gname, label, url in url_checks:
            ok, detail = url_resolves(url)
            if not ok:
                errors.append(
                    f"Genome {gname}: {label} URL does not resolve "
                    f"({detail}): {url}"
                )

    if errors:
        print(f"\n  Found {len(errors)} error(s):", file=sys.stderr)
        for e in errors:
            print(f"    - {e}", file=sys.stderr)
    else:
        print("\n  Configuration looks good.", file=sys.stderr)

    # Optionally run snakemake dry-run for full DAG validation
    if not errors:
        print("\n  Running snakemake dry-run for DAG validation...\n",
              file=sys.stderr)
        cmd = build_snakemake_cmd(args, extra_args, dry_run=True)
        # In verbose mode, stream snakemake's output directly. Otherwise
        # capture it and surface only the diagnostic summary (rule counts,
        # files-to-be-removed, etc.) — most users care about "what would
        # the pipeline do" rather than the full DAG dump. On dry-run
        # failure, the captured output is dumped so the user can debug.
        if args.verbose:
            result = subprocess.run(cmd)
            if result.returncode == 0:
                print("\nEPICC: Validation passed.", file=sys.stderr)
                maybe_render_graphs(args)
            else:
                print(f"\nEPICC: Dry-run validation failed (exit code "
                      f"{result.returncode}).", file=sys.stderr)
                return result.returncode
            if getattr(args, "build_envs", False):
                return _run_build_envs(args, extra_args)
            return 0

        result = subprocess.run(cmd, capture_output=True, text=True)
        if result.returncode == 0:
            summary = _summarize_dryrun(result.stdout, result.stderr)
            if summary:
                print(summary, file=sys.stderr)
                print("", file=sys.stderr)
            print("EPICC: Validation passed.", file=sys.stderr)
            print("  (re-run with --verbose to see the full snakemake output)",
                  file=sys.stderr)
            maybe_render_graphs(args)
            if getattr(args, "build_envs", False):
                return _run_build_envs(args, extra_args)
            return 0
        else:
            print(f"\nEPICC: Dry-run validation failed (exit code "
                  f"{result.returncode}). Full snakemake output below:\n",
                  file=sys.stderr)
            if result.stdout:
                sys.stderr.write(result.stdout)
            if result.stderr:
                sys.stderr.write(result.stderr)
        return result.returncode

    return 1 if errors else 0


def _summarize_dryrun(stdout, stderr):
    """Extract a concise summary from snakemake dry-run output.

    Pulls the ``Job stats:`` table (rule → count, plus the totals row), any
    ``Removing files...`` notice, and any leading warnings — drops the
    per-job rule blocks that dominate the volume. Returns the formatted
    block as a string, or ``None`` if nothing summary-like was found, in
    which case the caller can decide how to fall back.
    """
    sections = []

    # 1. Warnings printed before the DAG build (one-line each, on stderr).
    warning_lines = [
        line for line in stderr.splitlines()
        if line.lstrip().startswith(("Warning", "WARNING", "[!]"))
    ]
    if warning_lines:
        sections.append("\n".join(warning_lines))

    # 2. The Job stats: table — present whenever snakemake plans any jobs.
    lines = stdout.splitlines()
    block = []
    in_block = False
    seen_total = False
    for line in lines:
        if line.startswith("Job stats:"):
            in_block = True
        if in_block:
            block.append(line)
            stripped = line.lstrip()
            if stripped.startswith("total"):
                seen_total = True
                continue
            if seen_total and line.strip() == "":
                break
    if block:
        sections.append("\n".join(block).rstrip())

    # 3. Files snakemake plans to remove (typical when temp/touch outputs
    # are stale, or after a configuration change).
    remove_lines = [
        line for line in stdout.splitlines()
        if line.lstrip().startswith("Removing")
    ]
    if remove_lines:
        sections.append("Files to be removed:\n  " + "\n  ".join(remove_lines))

    if not sections:
        return None
    return "\n\n".join(sections)


