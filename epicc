def parse_version(text):
    """Leading numeric components of a version string, padded to three.

    '9.21.0' -> (9, 21, 0); '9' -> (9, 0, 0); '9.1.0rc1' -> (9, 1, 0).
    Returns None if no leading number can be read.
    """
    head = text.split()[0] if text.split() else ""
    nums = []
    for part in head.lstrip("vV").split(".")[:3]:
        digits = ""
        for ch in part:
            if not ch.isdigit():
                break
            digits += ch
        if not digits:
            break
        nums.append(int(digits))
    if not nums:
        return None
    return tuple(nums + [0] * (3 - len(nums)))


def check_snakemake_version():
    """Fail early if the snakemake on PATH is too old to run this workflow.

    The workflow's own min_version() guard cannot catch this: snakemake 7
    rejects `--executor` while parsing arguments, long before it reads the
    Snakefile, so the user sees "unrecognized arguments: --executor=slurm"
    instead of a version complaint. The resolved path is reported alongside
    the version because the usual cause is a stale environment shadowing the
    intended one on PATH.
    """
    exe = shutil.which("snakemake")
    if exe is None:
        sys.exit(
            "Error: snakemake not found on PATH. Activate the epicc conda "
            "environment first:\n"
            "    conda activate epicc\n"
            "  To build it:  conda create -n epicc -y --file config/epicc-env.txt"
        )

    try:
        proc = subprocess.run(
            [exe, "--version"], capture_output=True, text=True, timeout=120
        )
    except (OSError, subprocess.SubprocessError) as exc:
        sys.exit(f"Error: could not run '{exe} --version': {exc}")

    raw = ((proc.stdout or "") + (proc.stderr or "")).strip()
    found = parse_version(raw)
    if found is None:
        # Don't turn an unreadable version into a hard stop -- a git checkout
        # or dev build should still run.
        print(
            f"Warning: could not read a version from '{exe} --version' "
            f"(got {raw!r}); skipping the snakemake version check.",
            file=sys.stderr,
        )
        return

    if found < MIN_SNAKEMAKE:
        need = ".".join(str(n) for n in MIN_SNAKEMAKE)
        shown = ".".join(str(n) for n in found)
        sys.exit(
            f"Error: epicc needs snakemake >= {need}, but found {shown} at\n"
            f"    {exe}\n"
            "  Older snakemake rejects the flags epicc passes (e.g.\n"
            "  \"unrecognized arguments: --executor=slurm\").\n"
            "  A stale environment earlier on PATH is the usual cause -- note that\n"
            "  environment names are case-sensitive, so 'EPICC' and 'epicc' are\n"
            "  different environments. Check which one is active:\n"
            "    conda activate epicc && snakemake --version\n"
            "  To rebuild:  conda create -n epicc -y --file config/epicc-env.txt"
        )


def active_slurm_job_ids():
    """IDs of the user's queued/running SLURM jobs, or None if unknowable.

    None means "no SLURM answer available" (no squeue, or it failed) and must
    be treated as "cannot rule out a live job", not as "nothing is running".
    """
    if shutil.which("squeue") is None:
        return None
    try:
        proc = subprocess.run(
            ["squeue", "--noheader", "--me", "--format=%i"],
            capture_output=True, text=True, timeout=60,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode != 0:
        return None
    ids = set()
    for line in proc.stdout.split():
        # Array tasks appear as "12345_7"; the scratch dir is named from
        # SLURM_JOB_ID, so key on the leading numeric component.
        ids.add(line.strip().split("_")[0])
    return ids


def parse_tmp_dir_name(name):
    """Split a scratch dir name into (slurm_job_id, pid).

    The shell.prefix names these "${SLURM_JOB_ID:-local}.$$", so a SLURM job
    gives "3060216.12345" and a local run gives "local.12345". Returns
    (None, None) for anything that doesn't match, so unknown entries are left
    alone rather than guessed at.
    """
    parts = name.rsplit(".", 1)
    if len(parts) != 2 or not parts[1].isdigit():
        return (None, None)
    job, pid = parts
    if job == "local":
        return (None, pid)
    if job.isdigit():
        return (job, pid)
    return (None, None)


def sweep_tmp_dirs(tmp_root, min_age_hours, active_jobs):
    """Classify scratch dirs under tmp_root into (reclaimable, skipped).

    Two independent gates, both of which must pass before a directory is
    considered reclaimable, because deleting scratch from under a live job
    would corrupt it:

      1. It must not belong to a SLURM job that is still queued or running.
         If the job list is unknowable, every SLURM-named dir is skipped.
      2. It must not have been modified within min_age_hours.

    `skipped` entries carry a reason so the caller can say why.
    """
    reclaimable, skipped = [], []
    cutoff = time.time() - (min_age_hours * 3600)

    for entry in sorted(tmp_root.iterdir()):
        if not entry.is_dir():
            continue
        job, pid = parse_tmp_dir_name(entry.name)

        if job is not None:
            if active_jobs is None:
                skipped.append((entry, "SLURM job status unknown"))
                continue
            if job in active_jobs:
                skipped.append((entry, f"SLURM job {job} still active"))
                continue
        elif pid is None:
            skipped.append((entry, "unrecognized name"))
            continue

        try:
            mtime = entry.stat().st_mtime
        except OSError as exc:
            skipped.append((entry, f"cannot stat ({exc.strerror})"))
            continue
        if mtime > cutoff:
            skipped.append((entry, f"modified < {min_age_hours:g}h ago"))
            continue

        reclaimable.append(entry)

    return reclaimable, skipped


def find_repo_root():
    """Find the repository root (directory containing workflow/Snakefile)."""
    # Start from the script's own location (git-clone install)
    script_dir = Path(__file__).resolve().parent
    if (script_dir / "workflow" / "Snakefile").exists():
        return script_dir
    # Conda/pip install: workflow files at $PREFIX/share/epicc/
    share = Path(sys.prefix) / "share" / "epicc"
    if (share / "workflow" / "Snakefile").exists():
        return share
    # Fall back to cwd
    cwd = Path.cwd()
    if (cwd / "workflow" / "Snakefile").exists():
        return cwd
    sys.exit(
        "Error: Cannot find EPICC pipeline (workflow/Snakefile).\n"
        "Run this command from the pipeline directory, or ensure the epicc "
        "script is located at the repository root."
    )


def _is_installed_mode():
    """True when epicc is running from a conda/pip install, not a git clone.

    Git-clone mode: the epicc script sits in the repository root, adjacent to
    workflow/Snakefile. Installed mode: the script is in $PREFIX/bin/ and the
    workflow lives in $PREFIX/share/epicc/. Also returns False when the user
    runs epicc from the repo's CWD (supports running the script by path from
    a different location during development).
    """
    if (Path(__file__).resolve().parent / "workflow" / "Snakefile").exists():
        return False
    if (Path.cwd() / "workflow" / "Snakefile").exists():
        return False
    return True


def is_url(path):
    """Return True if the string looks like an HTTP(S) URL."""
    return isinstance(path, str) and (
        path.startswith("http://") or path.startswith("https://")
    )


def url_resolves(url, timeout=10):
    """Check whether an HTTP(S) URL resolves. Returns (ok, detail).

    Uses a ranged GET (bytes=0-0) rather than HEAD because some hosts (e.g.
    CDN-fronted downloads) mishandle HEAD. Follows redirects via urllib's
    default opener.
    """
    import urllib.error
    import urllib.request
    req = urllib.request.Request(url, headers={"Range": "bytes=0-0"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            code = resp.getcode()
            return code < 400, f"HTTP {code}"
    except urllib.error.HTTPError as e:
        return False, f"HTTP {e.code}"
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        return False, str(e)


def fmt_duration(seconds):
    """Format seconds as human-readable duration."""
    if seconds < 60:
        return f"{seconds:.0f}s"
    elif seconds < 3600:
        m, s = divmod(seconds, 60)
        return f"{int(m)}m {int(s)}s"
    else:
        h, rem = divmod(seconds, 3600)
        m, _ = divmod(rem, 60)
        return f"{int(h)}h {int(m)}m"


# Snakemake graph flags: (cli_kind, snakemake_flag)
GRAPH_KINDS = (("dag", "--dag"), ("rulegraph", "--rulegraph"))


def render_graph(args, kind, snakemake_flag, output_path):
    """Run `snakemake <flag>` and render its dot output to a file.

    Output format is inferred from ``output_path``'s extension.  ``.dot``
    writes the raw dot text; everything else is piped through graphviz
    ``dot -T<fmt>`` (png/svg/pdf/...). Requires the ``dot`` executable on PATH
    for non-``.dot`` outputs.
    """
    import shutil as _shutil

    out = Path(output_path)
    fmt = out.suffix.lstrip(".").lower() or "png"

    options_file = _prepare_options_file(args)
    repo = find_repo_root()
    cmd = ["snakemake", snakemake_flag,
           "--configfile", options_file,
           "--cores", "1", "--quiet", "all"]
    if _is_installed_mode():
        cmd += ["--snakefile", str(repo / "workflow" / "Snakefile")]
    # Honor the same workflow profile and config overrides as the run.
    workflow_profile = getattr(args, "workflow_profile", None) or str(
        repo / DEFAULT_WORKFLOW_PROFILE
    )
    if Path(workflow_profile).is_dir():
        cmd += ["--workflow-profile", workflow_profile]
    overrides = []
    if getattr(args, "samples", None):
        overrides.append(f"sample_file={args.samples}")
    overrides.extend(_collect_config_overrides(args))
    if overrides:
        cmd += ["--config"] + overrides

    print(f"EPICC: Generating {kind} → {out}", file=sys.stderr)
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr)
        return proc.returncode
    dot_text = proc.stdout

    if fmt == "dot":
        out.write_text(dot_text)
        return 0
    if not _shutil.which("dot"):
        sys.exit(
            f"Error: graphviz 'dot' not found on PATH (needed to render "
            f"{out}). Install graphviz, or output a .dot file instead."
        )
    render = subprocess.run(
        ["dot", f"-T{fmt}", "-o", str(out)],
        input=dot_text, text=True, capture_output=True,
    )
    if render.returncode != 0:
        sys.stderr.write(render.stderr)
    return render.returncode


def maybe_render_graphs(args):
    """If --dag or --rulegraph was requested, render and return True.

    Returns the number of graph files successfully written (0 if none asked).
    Caller decides whether to short-circuit downstream work.
    """
    written = 0
    for kind, flag in GRAPH_KINDS:
        out = getattr(args, kind, None)
        if not out:
            continue
        rc = render_graph(args, kind, flag, out)
        if rc != 0:
            sys.exit(rc)
        written += 1
    return written


def _lock_present(repo):
    """Return True if Snakemake's lock directory holds any lock files.

    Snakemake releases its lock on a clean exit and on most in-run failures,
    so a non-empty lock dir means either a run was killed (SLURM timeout,
    Ctrl-C, node/power loss) or a run was just refused because the lock was
    already there — exactly the cases where 'epicc unlock' is the fix.
    """
    # Installed mode: .snakemake/ is in the user's project CWD, not the repo.
    run_dir = Path.cwd() if _is_installed_mode() else repo
    locks = run_dir / ".snakemake" / "locks"
    return locks.exists() and any(locks.iterdir())


def maybe_clear_stale_lock(args, extra_args, repo):
    """Clear a stale Snakemake lock before running, but only if opted in.

    Killed runs (SLURM timeouts, Ctrl-C, node failures) leave files in
    `.snakemake/locks/` that block subsequent invocations until cleared. By
    default we mirror snakemake and leave the lock in place — a lock can also
    mean another run is genuinely active, and we can't reliably detect a live
    concurrent coordinator in a cluster environment (it could be on any node,
    and the lock files contain no PID/host info). Pass --auto-unlock to clear
    it automatically; otherwise the user is directed to 'epicc unlock'.
    """
    if not getattr(args, "auto_unlock", False):
        return
    if not _lock_present(repo):
        return
    run_dir = Path.cwd() if _is_installed_mode() else repo
    print("=" * 72, file=sys.stderr)
    print("EPICC WARNING: a Snakemake lock was found; --auto-unlock is set,",
          file=sys.stderr)
    print("  so it is being cleared. If another epicc/snakemake run is ACTIVE",
          file=sys.stderr)
    print("  on this same directory, unlocking will corrupt its state.",
          file=sys.stderr)
    print("=" * 72, file=sys.stderr)
    cmd = build_snakemake_cmd(args, extra_args, unlock=True)
    result = subprocess.run(cmd, cwd=str(run_dir))
    # Carrying on would only hit the lock again, with snakemake's
    # LockException hiding why the unlock itself failed.
    if result.returncode != 0:
        sys.exit(f"EPICC: --auto-unlock failed (exit code {result.returncode}); "
                 "see the snakemake error above.")


_PLACEHOLDER_RE = __import__("re").compile(r"<your-[a-z0-9-]+>", __import__("re").IGNORECASE)


def _strip_yaml_comment(line):
    """Return `line` with any trailing YAML comment removed.

    A `#` starts a comment unless it sits inside a quoted scalar. We don't
    need a full YAML parser here — just enough quote awareness to avoid
    chopping a value that legitimately contains `#`. Lines that are entirely
    a comment (the common `#- slurm_account=...` case) collapse to empty.
    """
    in_single = in_double = False
    for i, ch in enumerate(line):
        if ch == "'" and not in_double:
            in_single = not in_single
        elif ch == '"' and not in_single:
            in_double = not in_double
        elif ch == "#" and not in_single and not in_double:
            return line[:i]
    return line


def check_profile_placeholders(profile_arg):
    """Fail fast if the user's profile still ships an unedited placeholder.

    profiles/slurm/config.yaml ships `slurm_account="<your-slurm-account>"`
    as a *commented-out* example. Without this check, an account left at
    that placeholder value (once uncommented but not edited) makes sbatch
    silently reject every job and the run hangs at "Select jobs to
    execute..." with nothing visible in `squeue` — a debugging trap (see
    e.g. github.com/cahnlab/EPICC/issues/... for the original
    report). Surface the unedited value upfront with a pointer back at the
    offending file so the user knows exactly what to fix.

    We only scan *active* (non-comment) config: a placeholder that lives
    in a commented-out line is an example the user hasn't opted into — most
    notably the shipped `#- slurm_account="<your-slurm-account>"`, which a
    user can simply leave alone to let SLURM assign its default account.
    Flagging that would force users to specify an account that their
    cluster doesn't actually require.

    `profile_arg` is whatever the user passed to --profile (a directory
    or a config.yaml path); this resolves either to the actual config
    file before scanning.
    """
    if not profile_arg:
        return
    repo = find_repo_root()
    candidate = Path(profile_arg)
    if not candidate.is_absolute():
        # Try repo-relative first, then XDG Snakemake config dir.
        repo_rel = (repo / candidate).resolve()
        if repo_rel.exists():
            candidate = repo_rel
        else:
            xdg = os.environ.get("XDG_CONFIG_HOME")
            smk_cfg = Path(xdg) / "snakemake" if xdg else Path.home() / ".config" / "snakemake"
            xdg_profile = smk_cfg / candidate
            candidate = xdg_profile if xdg_profile.exists() else repo_rel
    if candidate.is_dir():
        config_path = candidate / "config.yaml"
    else:
        config_path = candidate
    if not config_path.exists():
        return  # snakemake will report the missing-profile error itself
    active = "\n".join(
        _strip_yaml_comment(line) for line in config_path.read_text().splitlines()
    )
    placeholders = sorted(set(_PLACEHOLDER_RE.findall(active)))
    if not placeholders:
        return
    print(
        "EPICC: profile contains unedited placeholder value(s):",
        file=sys.stderr,
    )
    for ph in placeholders:
        print(f"    {ph}", file=sys.stderr)
    print(
        f"  in: {config_path}\n"
        "  Edit that file to fill in the real value(s) for your cluster, "
        "or remove the offending lines if not applicable. Without this fix, "
        "sbatch will silently reject every job and the run will hang at "
        "'Select jobs to execute...' with nothing in the queue.",
        file=sys.stderr,
    )
    sys.exit(2)


def detect_execution_mode(args):
    """Determine whether to use a SLURM profile or local cores.

    Returns (profile_path, cores) — one will be None.
    """
    if args.profile:
        return args.profile, None
    if args.cores:
        return None, args.cores

    # Auto-detect: SLURM if sbatch is available
    if shutil.which("sbatch"):
        repo = find_repo_root()
        if not (repo / DEFAULT_PROFILE / "config.yaml").exists():
            print(f"Warning: sbatch found but {DEFAULT_PROFILE}/config.yaml missing; "
                  f"falling back to local execution.", file=sys.stderr)
            cores = max(1, os.cpu_count() // 2)
            return None, cores
        # Installed mode: return absolute path; git-clone: relative (resolves
        # after os.chdir(repo) in cmd_run).
        profile = str(repo / DEFAULT_PROFILE) if _is_installed_mode() else DEFAULT_PROFILE
        return profile, None

    cores = max(1, os.cpu_count() // 2)
    return None, cores


def _parse_dmr_min_diff(s):
    """Argument type for --dmr-min-diff.

    Accepted forms:
      auto                    → data-driven calibration
      0.3                     → apply the same threshold to all three contexts
      CG=0.3,CHG=0.2,CHH=0.1 → per-context values (any subset is valid)
    """
    if s.lower() == "auto":
        return "auto"
    if "=" not in s:
        try:
            return float(s)
        except ValueError:
            raise argparse.ArgumentTypeError(
                f"--dmr-min-diff: expected 'auto', a float, or 'CG=F,CHG=F,CHH=F'; got {s!r}"
            )
    result = {}
    for pair in s.split(","):
        pair = pair.strip()
        if not pair:
            continue
        k, _, v = pair.partition("=")
        k = k.strip().upper()
        if k not in ("CG", "CHG", "CHH"):
            raise argparse.ArgumentTypeError(
                f"--dmr-min-diff: unknown context {k!r}; expected CG, CHG, or CHH"
            )
        try:
            result[k] = float(v.strip())
        except ValueError:
            raise argparse.ArgumentTypeError(
                f"--dmr-min-diff: invalid value for {k}: {v!r}"
            )
    if not result:
        raise argparse.ArgumentTypeError("--dmr-min-diff: no valid context=value pairs")
    return result


def _collect_config_overrides(args):
    """Collect --config key=value pairs from epicc CLI flags (excluding sample_file).

    Covers only top-level config keys that Snakemake can receive directly via
    --config. Used by both build_snakemake_cmd and render_graph.
    """
    ov = []
    if getattr(args, "output_dir", None):
        ov.append(f"output_dir={args.output_dir}")
    if getattr(args, "genome_dir", None):
        ov.append(f"genome_dir={args.genome_dir}")
    if getattr(args, "keep_intermediates", None):
        ov.append(f"keep_intermediates={args.keep_intermediates}")
    if getattr(args, "use_node_tmpdir", False):
        ov.append("use_node_tmpdir=true")
    # Aligner / mapping strategy
    if getattr(args, "chip_aligner", None):
        ov.append(f"chip_aligner={args.chip_aligner}")
    if getattr(args, "atac_aligner", None):
        ov.append(f"atac_aligner={args.atac_aligner}")
    if getattr(args, "chip_mapping_strategy", None):
        ov.append(f"chip_mapping_strategy={args.chip_mapping_strategy}")
    if getattr(args, "atac_mapping_strategy", None):
        ov.append(f"atac_mapping_strategy={args.atac_mapping_strategy}")
    # Analysis toggles
    if getattr(args, "full_analysis", None) is not None:
        ov.append(f"full_analysis={'true' if args.full_analysis else 'false'}")
    if getattr(args, "te_analysis", None) is not None:
        ov.append(f"te_analysis={'true' if args.te_analysis else 'false'}")
    if getattr(args, "GO", None) is not None:
        ov.append(f"GO={'true' if args.GO else 'false'}")
    if getattr(args, "rna_deduplicate", None) is not None:
        ov.append(f"rna_deduplicate={'true' if args.rna_deduplicate else 'false'}")
    # Methylation / DMR (top-level keys)
    if getattr(args, "methylation_contexts", None):
        ov.append(f"methylation_contexts=[{','.join(args.methylation_contexts)}]")
    if getattr(args, "dmr_caller", None):
        ov.append(f"dmr_caller={args.dmr_caller}")
    return ov


def _collect_nested_overrides(args):
    """Collect dot-path overrides for nested config keys.

    Returns a list of (dotpath, value) tuples for settings that live inside
    nested YAML blocks (e.g. dmr_thresholds.min_diff.CG) and therefore cannot
    be passed directly as Snakemake --config key=val — Snakemake's shallow merge
    would drop sibling keys in the same block.
    """
    nested = []

    # DMR thresholds
    dmr_min_diff = getattr(args, "dmr_min_diff", None)
    if dmr_min_diff is not None:
        if dmr_min_diff == "auto":
            nested.append(("dmr_thresholds.min_diff", "auto"))
        elif isinstance(dmr_min_diff, float):
            for ctx in ("CG", "CHG", "CHH"):
                nested.append((f"dmr_thresholds.min_diff.{ctx}", dmr_min_diff))
        else:  # dict from per-context form
            for ctx, val in dmr_min_diff.items():
                nested.append((f"dmr_thresholds.min_diff.{ctx}", val))
    if getattr(args, "dmr_min_cytosines", None) is not None:
        nested.append(("dmr_thresholds.min_cytosines", args.dmr_min_cytosines))
    if getattr(args, "dmr_q_value", None) is not None:
        nested.append(("dmr_thresholds.q_value", args.dmr_q_value))
    if getattr(args, "dmr_sigma_n", None) is not None:
        nested.append(("dmr_thresholds.sigma_n", args.dmr_sigma_n))

    # Peak calling
    if getattr(args, "chip_callpeaks_params", None) is not None:
        nested.append(("chip_callpeaks.params", args.chip_callpeaks_params))
    if getattr(args, "cut_broad_caller", None) is not None:
        nested.append(("cut_callpeaks.broad_caller", args.cut_broad_caller))
    if getattr(args, "cut_narrow_caller", None) is not None:
        nested.append(("cut_callpeaks.narrow_caller", args.cut_narrow_caller))

    return nested


def _prepare_options_file(args):
    """Return the options file path to use for snakemake.

    When nested CLI overrides (e.g. --dmr-min-diff-cg) are present, writes
    a temporary merged config that incorporates those overrides and returns
    its path. The temp file is registered for cleanup via atexit. When no
    nested overrides are set, returns args.options unchanged.
    """
    nested = _collect_nested_overrides(args)
    if not nested:
        return args.options

    try:
        import yaml
    except ImportError:
        sys.exit("Error: PyYAML not available. Activate the epicc conda environment.")
    import tempfile
    import atexit

    with open(args.options) as f:
        config = yaml.safe_load(f) or {}

    for dotpath, value in nested:
        parts = dotpath.split(".")
        d = config
        for part in parts[:-1]:
            if not isinstance(d.get(part), dict):
                d[part] = {}
            d = d[part]
        d[parts[-1]] = value

    tmp = tempfile.NamedTemporaryFile(
        mode="w", suffix=".yaml", prefix="epicc_merged_", delete=False
    )
    yaml.dump(config, tmp, default_flow_style=False, allow_unicode=True)
    tmp.close()
    atexit.register(lambda p=tmp.name: os.path.exists(p) and os.unlink(p))
    return tmp.name


def build_snakemake_cmd(args, extra_args, *, dry_run=False, unlock=False):
    """Construct the snakemake command line from parsed arguments.

    unlock=True builds the matching `snakemake --unlock` call. It has to carry
    the run's full config: snakemake parses the Snakefile before unlocking,
    and the Snakefile reads the sample sheet, so an unlock that drops a
    --samples override fails wherever the options file's own sample_file is
    stale.
    """
    repo = find_repo_root()

    cmd = ["snakemake"]
    # Installed mode (conda/pip): must point snakemake at the installed
    # Snakefile explicitly since we don't os.chdir to the repo.
    if _is_installed_mode():
        cmd += ["--snakefile", str(repo / "workflow" / "Snakefile")]

    # Options file — may be replaced by a temp merged file when nested CLI
    # overrides (--dmr-min-diff, --chip-callpeaks-params, etc.) are present.
    options_file = _prepare_options_file(args)
    if not Path(options_file).exists():
        sys.exit(f"Error: Options file not found: {options_file}")
    cmd += ["--configfile", options_file]

    # Workflow profile — per-rule resource and thread tuning. Ships with the
    # repo; users normally should not edit it. Override with --workflow-profile.
    workflow_profile = getattr(args, "workflow_profile", None) or str(
        repo / DEFAULT_WORKFLOW_PROFILE
    )
    if Path(workflow_profile).is_dir():
        cmd += ["--workflow-profile", workflow_profile]

    # Execution mode
    profile, cores = detect_execution_mode(args)
    if profile:
        cmd += ["--profile", profile]
    else:
        cmd += ["--use-conda", "--conda-frontend", "conda", "--cores", str(cores)]

    # Config overrides via --config key=value — collected here, emitted below
    # after merging any --config values from extra_args (the -- passthrough).
    # Snakemake with multiple --config flags uses the LAST one, silently
    # dropping keys from earlier blocks (empirically confirmed; see issue #31).
    # Merging into a single block avoids that.
    config_overrides = []
    if args.samples:
        if not Path(args.samples).exists():
            sys.exit(f"Error: Sample file not found: {args.samples}")
        config_overrides.append(f"sample_file={args.samples}")
    config_overrides.extend(_collect_config_overrides(args))

    # Dry-run
    if dry_run:
        cmd.append("--dry-run")
    if unlock:
        cmd.append("--unlock")

    # Re-run any jobs Snakemake marked incomplete on a prior interrupted run.
    # Without this, Snakemake errors out on the first affected rule, which is
    # almost never what the user wants when resuming. The --no-rerun-incomplete
    # flag opts out (e.g. when investigating which jobs are flagged incomplete,
    # or to force a fresh start without re-running them).
    if not getattr(args, "no_rerun_incomplete", False):
        cmd.append("--rerun-incomplete")

    # Verbosity
    if args.verbose:
        cmd.append("--printshellcmds")
    if args.quiet:
        cmd.append("--quiet")

    # Subcommand-specific options
    if hasattr(args, 'target') and args.target:
        cmd.append(args.target)
    if hasattr(args, 'until') and args.until:
        cmd += ["--until", args.until]
    if hasattr(args, 'forcerun') and args.forcerun:
        cmd += ["--forcerun"] + args.forcerun

    # Passthrough arguments (everything after --).
    # Extract any --config key=value tokens and merge into config_overrides so
    # the entire config lives in a single --config block. Snakemake's last
    # --config wins, so if we emitted ours first and the user's --config
    # follows in the passthrough, keys like sample_file get silently dropped.
    filtered_extra = []
    i = 0
    while i < len(extra_args):
        if extra_args[i] == "--config":
            i += 1
            while i < len(extra_args) and "=" in extra_args[i] and not extra_args[i].startswith("-"):
                config_overrides.append(extra_args[i])
                i += 1
        elif extra_args[i].startswith("--config="):
            config_overrides.append(extra_args[i][len("--config="):])
            i += 1
        else:
            filtered_extra.append(extra_args[i])
            i += 1

    # Passthrough args (positional targets + extra Snakemake flags) must be
    # emitted BEFORE the --config block. --config uses nargs="*" and greedily
    # consumes the tokens that follow it, so a target path placed after it gets
    # mis-parsed as a key=value config entry and Snakemake aborts ("Config
    # entries have to be defined as name=value pairs"). Putting --config last
    # keeps its overrides self-contained.
    if filtered_extra:
        cmd += filtered_extra
    if config_overrides:
        cmd += ["--config"] + config_overrides

    return cmd


